#!/usr/bin/env bash
#
# ai-tool - Install, list and uninstall AppImages in the user's home directory,
#           extracting their original icon and registering them in the desktop
#           application menu. Includes a secure self-update mechanism.
#
# Author:      Angel <angel@zbk>
# License:     MIT
# Version:     1.2.0
# Repository:  https://github.com/angelgnzlz/ai-tool
#
set -euo pipefail

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
readonly SCRIPT_NAME="$(basename "${0}")"
readonly SCRIPT_VERSION="1.2.0"

readonly APP_DIR="${HOME}/.local/bin"
readonly ICON_DIR="${HOME}/.local/share/icons"
readonly DESKTOP_DIR="${HOME}/.local/share/applications"

readonly REPO_OWNER="angelgnzlz"
readonly REPO_NAME="ai-tool"
readonly GITHUB_API="https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}"
readonly GITHUB_RAW="https://raw.githubusercontent.com/${REPO_OWNER}/${REPO_NAME}"

# Colors (only when stdout is a terminal)
if [ -t 1 ]; then
    readonly C_RESET="\033[0m"
    readonly C_RED="\033[31m"
    readonly C_GREEN="\033[32m"
    readonly C_YELLOW="\033[33m"
    readonly C_BLUE="\033[34m"
else
    readonly C_RESET="" C_RED="" C_GREEN="" C_YELLOW="" C_BLUE=""
fi

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------
info()  { printf "${C_BLUE}==>${C_RESET} %s\n" "$*"; }
ok()    { printf "${C_GREEN}==>${C_RESET} %s\n" "$*"; }
warn()  { printf "${C_YELLOW}Warning:${C_RESET} %s\n" "$*" >&2; }
error() { printf "${C_RED}Error:${C_RESET} %s\n" "$*" >&2; }
die()   { error "$*"; exit 1; }

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------
show_help() {
    cat <<EOF
${SCRIPT_NAME} v${SCRIPT_VERSION} - AppImage manager for the current user

USAGE
  ${SCRIPT_NAME} -i|--install <path.AppImage> [name] [wm_class]
  ${SCRIPT_NAME} -u|--uninstall <id_or_name>
  ${SCRIPT_NAME} -l|--list
  ${SCRIPT_NAME} -U|--update
  ${SCRIPT_NAME} -h|--help
  ${SCRIPT_NAME} -V|--version

OPTIONS
  -i, --install <path> [name] [wm_class]
        Install the given AppImage.
          <path>      Path to the .AppImage file (required).
          [name]      Name shown in the application menu (optional). If
                      omitted, the file name is cleaned up automatically.
          [wm_class]  Value for StartupWMClass (optional). If omitted, the
                      script tries to auto-detect it from the .desktop file
                      bundled inside the AppImage. If no .desktop file is
                      found, [name] is used as the value.
  -u, --uninstall <id_or_name>
        Uninstall the given AppImage. Accepts the ID (e.g. obsidian) or the
        displayed name (e.g. Obsidian), case-insensitive.
  -l, --list
        List AppImages installed with this tool.
  -U, --update
        Check for a newer release on GitHub, verify its checksum and update
        the script in place. Requires curl and sha256sum.
  -h, --help
        Show this help and exit.
  -V, --version
        Show the version and exit.

EXAMPLES
  # Basic install (WM_CLASS auto-detected from the AppImage)
  ${SCRIPT_NAME} -i ~/Downloads/MyApp.AppImage "MyApp"

  # Install with explicit WM_CLASS (overrides auto-detection)
  ${SCRIPT_NAME} -i ~/Downloads/Obsidian-1.14.5-arm64.AppImage "Obsidian" "md.obsidian.Obsidian"

  # Install without a custom name
  ${SCRIPT_NAME} -i ~/Downloads/MyApp.AppImage

  # List, uninstall and update
  ${SCRIPT_NAME} --list
  ${SCRIPT_NAME} --uninstall Obsidian
  ${SCRIPT_NAME} --update

NOTE ABOUT GNOME
  On GNOME, if the dock shows a generic gear icon and the window's internal
  name instead of the defined name, GNOME cannot associate the window with the
  .desktop file. This is fixed with the StartupWMClass key.

  The script first tries to read StartupWMClass from the .desktop file that
  the AppImage bundles. If that file is missing or does not define the key,
  it falls back to [name]. If the dock still shows the wrong icon or name,
  pass the third argument explicitly. You can get the value by opening the
  app and hovering over its window in the dock.

DIRECTORIES
  AppImages:  ${APP_DIR}
  Icons:      ${ICON_DIR}
  Entries:    ${DESKTOP_DIR}

DEPENDENCIES
  - bash >= 4.0
  - update-desktop-database (optional, recommended)
  - curl and sha256sum (only required for --update)
EOF
}

# ---------------------------------------------------------------------------
# Pre-flight checks
# ---------------------------------------------------------------------------
check_dependencies() {
    command -v update-desktop-database >/dev/null 2>&1 \
        || warn "update-desktop-database not found; the menu may not refresh immediately."
}

# ---------------------------------------------------------------------------
# List installed AppImages
# ---------------------------------------------------------------------------
list_apps() {
    info "AppImages installed in ${DESKTOP_DIR}:"
    if [ ! -d "${DESKTOP_DIR}" ] || [ -z "$(ls -A "${DESKTOP_DIR}" 2>/dev/null)" ]; then
        echo "    (none)"
        return 0
    fi
    local found=0 f name exec_line
    for f in "${DESKTOP_DIR}"/*.desktop; do
        [ -e "${f}" ] || continue
        exec_line=$(grep -m1 '^Exec=' "${f}" | cut -d= -f2- | awk '{print $1}')
        if echo "${exec_line}" | grep -q "${APP_DIR}"; then
            name=$(grep -m1 '^Name=' "${f}" | cut -d= -f2-)
            printf "    - %s  (%s)\n" "${name}" "$(basename "${f}" .desktop)"
            found=1
        fi
    done
    [ "${found}" -eq 1 ] || echo "    (none)"
}

# ---------------------------------------------------------------------------
# Find the .desktop file associated with an ID or name
# ---------------------------------------------------------------------------
find_desktop_file() {
    local target="$1"
    local f name exec_line

    if [ -f "${DESKTOP_DIR}/${target}.desktop" ]; then
        echo "${DESKTOP_DIR}/${target}.desktop"
        return 0
    fi

    for f in "${DESKTOP_DIR}"/*.desktop; do
        [ -e "${f}" ] || continue
        exec_line=$(grep -m1 '^Exec=' "${f}" | cut -d= -f2- | awk '{print $1}')
        echo "${exec_line}" | grep -q "${APP_DIR}" || continue
        name=$(grep -m1 '^Name=' "${f}" | cut -d= -f2-)
        if [ "$(echo "${name}" | tr '[:upper:]' '[:lower:]')" = "$(echo "${target}" | tr '[:upper:]' '[:lower:]')" ]; then
            echo "${f}"
            return 0
        fi
    done
    return 1
}

# ---------------------------------------------------------------------------
# Uninstall
# ---------------------------------------------------------------------------
uninstall_app() {
    local target="${1:-}"
    [ -n "${target}" ] || die "missing ID or name to uninstall. Use '${SCRIPT_NAME} --help'."

    local desktop_file appimage icon
    if ! desktop_file=$(find_desktop_file "${target}"); then
        die "'${target}' not found. Use '${SCRIPT_NAME} --list' to see installed AppImages."
    fi

    appimage=$(grep -m1 '^Exec=' "${desktop_file}" | cut -d= -f2- | awk '{print $1}')
    icon=$(grep -m1 '^Icon=' "${desktop_file}" | cut -d= -f2-)

    info "Uninstalling: $(basename "${desktop_file}" .desktop)"
    [ -n "${appimage}" ] && [ -f "${appimage}" ] && { rm -f "${appimage}"; echo "    Removed: ${appimage}"; }
    [ -n "${icon}" ] && [ -f "${icon}" ] && { rm -f "${icon}"; echo "    Removed: ${icon}"; }
    rm -f "${desktop_file}"; echo "    Removed: ${desktop_file}"

    command -v update-desktop-database >/dev/null 2>&1 \
        && update-desktop-database "${DESKTOP_DIR}" >/dev/null 2>&1 || true

    ok "Uninstall complete."
}

# ---------------------------------------------------------------------------
# Extract icon and bundled .desktop metadata from the AppImage
# ---------------------------------------------------------------------------
# Sets two global variables:
#   EXTRACTED_ICON     path to the copied icon (or a generic fallback)
#   EXTRACTED_WMCLASS  value of StartupWMClass from the bundled .desktop, or empty
extract_metadata() {
    local appimage="$1" app_id="$2" filename="$3"
    EXTRACTED_ICON=""
    EXTRACTED_WMCLASS=""

    local tmp_dir
    tmp_dir=$(mktemp -d)
    trap 'rm -rf "${tmp_dir}"' RETURN

    ( cd "${tmp_dir}" && "${appimage}" --appimage-extract >/dev/null 2>&1 ) || true

    local squash="${tmp_dir}/squashfs-root"
    if [ -d "${squash}" ]; then
        # --- Icon ---
        local icon_found=""
        icon_found=$(find "${squash}" -type f \( -iname "*.png" -o -iname "*.svg" -o -iname "*.xpm" \) \
            | grep -iE "(^|/)(${app_id}|${filename}|icon|logo)" | head -n 1 || true)
        if [ -z "${icon_found}" ]; then
            icon_found=$(find "${squash}/usr/share/icons" -type f \( -iname "*.png" -o -iname "*.svg" \) 2>/dev/null | head -n 1 || true)
        fi
        if [ -z "${icon_found}" ]; then
            icon_found=$(find "${squash}" -maxdepth 2 -type f \( -iname "*.png" -o -iname "*.svg" \) 2>/dev/null | head -n 1 || true)
        fi

        if [ -n "${icon_found}" ]; then
            local ext="${icon_found##*.}"
            EXTRACTED_ICON="${ICON_DIR}/${app_id}.${ext}"
            cp "${icon_found}" "${EXTRACTED_ICON}"
        fi

        # --- StartupWMClass from the bundled .desktop ---
        local bundled_desktop=""
        bundled_desktop=$(find "${squash}" -maxdepth 2 -name "*.desktop" -type f 2>/dev/null | head -n 1 || true)
        if [ -n "${bundled_desktop}" ]; then
            EXTRACTED_WMCLASS=$(grep -m1 '^StartupWMClass=' "${bundled_desktop}" \
                | cut -d= -f2- | tr -d '[:space:]' || true)
        fi
    fi

    [ -n "${EXTRACTED_ICON}" ] || EXTRACTED_ICON="application-x-executable"
}

# ---------------------------------------------------------------------------
# Install
# ---------------------------------------------------------------------------
install_app() {
    local appimage_path="${1:-}"
    local custom_name="${2:-}"
    local wm_class_arg="${3:-}"

    [ -n "${appimage_path}" ] || die "missing AppImage path. Use '${SCRIPT_NAME} --help'."
    [ -f "${appimage_path}" ] || die "file not found: ${appimage_path}"

    local filename clean_name app_name app_id
    filename=$(basename "${appimage_path}" .AppImage)
    clean_name=$(echo "${filename}" | sed -E 's/[-_][0-9]+\.[0-9]+.*$//; s/[-_]arm64$//; s/[-_]x86_64$//')
    app_name="${custom_name:-${clean_name}}"
    app_id=$(echo "${app_name}" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')

    info "Installing: ${app_name} (${app_id})"

    mkdir -p "${APP_DIR}" "${ICON_DIR}" "${DESKTOP_DIR}"

    local target_appimage="${APP_DIR}/${app_id}.AppImage"
    cp "${appimage_path}" "${target_appimage}"
    chmod +x "${target_appimage}"
    echo "    AppImage copied to: ${target_appimage}"

    # Extract icon and bundled metadata in a single pass
    extract_metadata "${target_appimage}" "${app_id}" "${filename}"
    local target_icon="${EXTRACTED_ICON}"
    echo "    Icon: ${target_icon}"

    # Determine StartupWMClass: explicit > bundled .desktop > app name
    local wm_class
    if [ -n "${wm_class_arg}" ]; then
        wm_class="${wm_class_arg}"
        echo "    StartupWMClass: ${wm_class} (explicit)"
    elif [ -n "${EXTRACTED_WMCLASS}" ]; then
        wm_class="${EXTRACTED_WMCLASS}"
        echo "    StartupWMClass: ${wm_class} (from AppImage metadata)"
    else
        wm_class="${app_name}"
        echo "    StartupWMClass: ${wm_class} (fallback to name)"
    fi

    local desktop_file="${DESKTOP_DIR}/${app_id}.desktop"
    cat > "${desktop_file}" <<EOF
[Desktop Entry]
Type=Application
Name=${app_name}
Comment=${app_name} (AppImage)
Exec=${target_appimage} %U
Icon=${target_icon}
Terminal=false
Categories=Utility;
StartupNotify=true
StartupWMClass=${wm_class}
EOF
    chmod +x "${desktop_file}"
    echo "    Menu entry: ${desktop_file}"

    command -v update-desktop-database >/dev/null 2>&1 \
        && update-desktop-database "${DESKTOP_DIR}" >/dev/null 2>&1 || true

    ok "${app_name} installed successfully."
    echo "    To uninstall: ${SCRIPT_NAME} --uninstall ${app_id}"
}

# ---------------------------------------------------------------------------
# Update
# ---------------------------------------------------------------------------
update_app() {
    info "Checking for updates..."

    for cmd in curl sha256sum; do
        command -v "${cmd}" >/dev/null 2>&1 \
            || die "'${cmd}' is required for --update. Please install it."
    done

    local api_response latest_tag
    api_response=$(curl -fsSL "${GITHUB_API}/releases/latest" 2>/dev/null) \
        || die "could not reach GitHub API. Check your network connection."

    latest_tag=$(echo "${api_response}" | grep -m1 '"tag_name"' | sed -E 's/.*"tag_name": *"([^"]+)".*/\1/')
    [ -n "${latest_tag}" ] || die "could not parse the latest release tag."

    local current_version="${SCRIPT_VERSION}"
    local latest_version="${latest_tag#v}"

    if [ "${current_version}" = "${latest_version}" ]; then
        ok "You are already on the latest version (${current_version})."
        return 0
    fi

    info "New version available: ${latest_version} (current: ${current_version})"
    printf "Do you want to update? [y/N] "
    local answer
    read -r answer
    case "${answer}" in
        [yY]|[yY][eE][sS]) ;;
        *) info "Update cancelled."; return 0 ;;
    esac

    local tmp_dir
    tmp_dir=$(mktemp -d)
    trap 'rm -rf "${tmp_dir}"' RETURN

    local new_script="${tmp_dir}/ai-tool"
    local sums_file="${tmp_dir}/SHA256SUMS"

    info "Downloading ai-tool ${latest_version}..."
    curl -fsSL "${GITHUB_RAW}/${latest_tag}/ai-tool" -o "${new_script}" \
        || die "failed to download the new script."
    curl -fsSL "${GITHUB_RAW}/${latest_tag}/SHA256SUMS" -o "${sums_file}" \
        || die "failed to download SHA256SUMS."

    info "Verifying checksum..."
    local expected actual
    expected=$(grep -E '[[:space:]]ai-tool$' "${sums_file}" | awk '{print $1}')
    [ -n "${expected}" ] || die "SHA256SUMS does not contain an entry for ai-tool."

    actual=$(sha256sum "${new_script}" | awk '{print $1}')
    if [ "${expected}" != "${actual}" ]; then
        die "checksum mismatch! Expected ${expected}, got ${actual}. Aborting."
    fi
    ok "Checksum verified."

    local target
    target=$(command -v ai-tool || true)
    [ -n "${target}" ] || die "could not locate the current ai-tool binary."

    local target_dir
    target_dir=$(dirname "${target}")
    cp "${new_script}" "${target_dir}/.ai-tool.new"
    chmod +x "${target_dir}/.ai-tool.new"
    mv -f "${target_dir}/.ai-tool.new" "${target}"

    ok "Updated to version ${latest_version}."
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------
main() {
    check_dependencies

    [ $# -ge 1 ] || { show_help; exit 1; }

    case "$1" in
        -i|--install)
            shift
            install_app "${1:-}" "${2:-}" "${3:-}"
            ;;
        -u|--uninstall)
            shift
            uninstall_app "${1:-}"
            ;;
        -l|--list)
            list_apps
            ;;
        -U|--update)
            update_app
            ;;
        -h|--help)
            show_help
            ;;
        -V|--version)
            echo "${SCRIPT_NAME} v${SCRIPT_VERSION}"
            ;;
        *)
            error "unknown option: '$1'"
            echo "Use '${SCRIPT_NAME} --help' for more information."
            exit 1
            ;;
    esac
}

main "$@"